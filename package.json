{
  "name": "tia-rts-typescript-experiment",
  "version": "0.1.0",
  "private": true,
  "description": "Experimento didático de Test Impact Analysis e Regression Test Selection com TypeScript e Fastify.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest run tests/products tests/cart tests/pricing tests/checkout",
    "test:integration": "vitest run tests/integration",
    "test:affected": "tsx scripts/run-affected-tests.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:ci && corepack pnpm build"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
